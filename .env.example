# Copia este archivo como .env y llena los valores que imprime `supabase status`.
# IMPORTANTE: usa la IP de esta PC en la red local (no localhost) para que
# las otras computadoras puedan conectarse. Ej.: http://192.168.1.50:54321
VITE_SUPABASE_URL=http://192.168.1.50:54321
VITE_SUPABASE_ANON_KEY=pega-aqui-la-anon-key

# Puerto donde se abrirá el sistema (http://IP:APP_PORT)
APP_PORT=80
